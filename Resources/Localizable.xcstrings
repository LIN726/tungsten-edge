        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder to pin to the taskbar"
          }
        }
      }
    },
    "Choose screenshots or screen recordings to send with your feedback.": {
      "comment": "设置窗口 · 反馈附件选择面板的说明",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要随反馈一起发送的截图或录屏。"
