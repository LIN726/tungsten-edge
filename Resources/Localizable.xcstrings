    "Turn on Tungsten Edge in %@. This window closes by itself once you do, and the taskbar finishes starting.": {
      "comment": "%@ 是系统设置里的权限路径，随 macOS 版本不同",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在%@中，打开 Tungsten Edge 钨极的开关。开启后本窗口会自动关闭，Dock 栏会继续启动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Tungsten Edge in %@. This window closes by itself once you do, and the taskbar finishes starting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在%@中打開Tungsten Edge的開關。打開後這個視窗會自動關閉，工作列也會繼續啟動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@でTungsten Edgeをオンにしてください。オンにするとこのウインドウは自動的に閉じ、タスクバーの起動が完了します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Tungsten Edge unter %@. Sobald du das getan hast, schließt sich dieses Fenster von selbst und die Taskleiste startet vollständig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Tungsten Edge dans %@. Cette fenêtre se ferme alors d’elle-même et la barre des tâches termine son démarrage."
          }
        }
      }
    },
