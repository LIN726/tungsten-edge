            "state": "translated",
            "value": "有项目暂时无法访问。请在系统隐私设置里允许钨极访问它们所在的文件夹。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some items can’t be accessed. Allow Tungsten Edge to access their folder in your Mac’s privacy settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些項目無法取用。請在Mac的隱私權設定裡允許Tungsten Edge取用它們所在的檔案夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の項目にアクセスできません。Macのプライバシー設定で、それらの項目があるフォルダへのTungsten Edgeのアクセスを許可してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einige Objekte kann nicht zugegriffen werden. Erlaube Tungsten Edge in den Datenschutzeinstellungen deines Macs den Zugriff auf den betreffenden Ordner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains éléments sont inaccessibles. Autorisez Tungsten Edge à accéder à leur dossier dans les réglages de confidentialité de votre Mac."
          }
        }
      }
    },
