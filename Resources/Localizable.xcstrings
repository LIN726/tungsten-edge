        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type"
          }
        }
      }
    },
    "Use at least one of Command, Control or Option.": {
      "comment": "设置窗口 · 改键被拒弹窗",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少要包含 ⌘、⌃ 或 ⌥ 中的一个。"
