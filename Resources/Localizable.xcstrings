    "One of the attachments could not be read.": {
      "comment": "反馈错误 · 附件读不出来",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一个附件读不出来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the attachments could not be read."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取其中一個附件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルのうち1つを読み込めませんでした。"
          }
        },
        "de": {
          "stringUnit": {
