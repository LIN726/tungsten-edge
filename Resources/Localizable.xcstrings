    "Can’t Open Dock Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开系统 Dock 设置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t Open Dock Settings"
          }
        }
      }
    },
    "Can’t Read That File": {
      "comment": "反馈附件被拒 · 文件读不出来",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读不出这个文件"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t Read That File"
          }
        }
      }
    },
    "Can’t Send Right Now": {
      "comment": "设置窗口 · 反馈失败弹窗标题",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法发送"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t Send Right Now"
          }
        }
      }
    },
    "Can’t Subscribe Right Now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法订阅"
          }
