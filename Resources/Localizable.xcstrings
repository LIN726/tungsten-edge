            "value": "钨极还在运行，可以重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge is still running. You can try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
