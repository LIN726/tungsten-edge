          }
        }
      }
    },
    "Your message or attachments were not accepted. Try shortening the message or using a different file, or email support@tungstenedge.app.": {
      "comment": "反馈失败 · 内容或附件被服务端拒绝",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容或附件没被接受。试着精简内容或换一个附件，或发邮件到 support@tungstenedge.app。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message or attachments were not accepted. Try shortening the message or using a different file, or email support@tungstenedge.app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的內容或附件沒有被接受。試著精簡內容或換一個檔案，或寄信到support@tungstenedge.app。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力した内容または添付ファイルが受け付けられませんでした。内容を短くするか、別のファイルでお試しください。support@tungstenedge.appまでメールでご連絡いただくこともできます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Text oder deine Anhänge wurden nicht angenommen. Kürze den Text oder nimm eine andere Datei – oder schreib eine E-Mail an support@tungstenedge.app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message ou vos pièces jointes ont été refusés. Essayez de raccourcir le message ou de changer de fichier, ou écrivez à support@tungstenedge.app."
          }
        }
      }
    },
    "You’re Already Subscribed": {
      "localizations": {
