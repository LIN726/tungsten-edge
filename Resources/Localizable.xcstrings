          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge"
          }
        }
      }
    },
    "Tungsten Edge (%@ to show/hide)": {
      "comment": "状态栏菜单组标题（%@ = 当前快捷键字形）",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge 钨极（%@ 显隐）"
