        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is already taken by another app. The previous shortcut stays active."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@已被其他App佔用，仍沿用原本的快速鍵。"
