          "stringUnit": {
            "state": "translated",
            "value": "Can’t locate this Finder window"
          }
        }
      }
    },
    "Can’t read this folder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取文件夹内容"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t read this folder"
          }
        }
      }
    },
    "Check Again": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检测"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Again"
          }
        }
      }
    },
    "Check for Updates…": {
      "comment": "状态栏菜单项",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates…"
          }
        }
      }
    },
    "Check for updates automatically": {
      "comment": "设置窗口「关于」区。自动检查默认开（SUEnableAutomaticChecks），这个开关是它唯一的关闭入口——不给关的后台联网检查比多一个勾选项糟糕得多。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for updates automatically"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检查更新"
          }
        }
      }
    },
    "Check whether there is a typo.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查一下是不是打错了。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check whether there is a typo."
          }
        }
      }
    },
    "Check your inbox and click the confirmation link to finish subscribing. If it is not there, check your spam folder, or the Promotions tab in Gmail.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请到邮箱点击确认链接完成订阅。如果收件箱没有，请查一下垃圾邮件；Gmail 则要看「推广」标签页。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your inbox and click the confirmation link to finish subscribing. If it is not there, check your spam folder, or the Promotions tab in Gmail."
          }
        }
      }
    },
    "Check your network connection and try again, or email support@tungstenedge.app.": {
      "comment": "设置窗口 · 反馈失败弹窗",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查网络后重试，或发邮件到 support@tungstenedge.app。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your network connection and try again, or email support@tungstenedge.app."
          }
        }
      }
    },
    "Check your network connection and try again, or leave your address on tungstenedge.app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络连接后重试，也可以到官网 tungstenedge.app 上留邮箱。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your network connection and try again, or leave your address on tungstenedge.app."
          }
        }
      }
    },
    "Choose a folder to pin to the taskbar": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要固定到 Dock 栏的文件夹"
          }
