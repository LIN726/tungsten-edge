    "Same as dragging the divider on the taskbar up or down.": {
      "comment": "设置窗口 · 通用",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和在 Dock 栏的分隔处上下拖动，改的是同一个值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same as dragging the divider on the taskbar up or down."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與在工作列分隔處上下拖移調整的是同一個值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクバーの区切り部分を上下にドラッグするのと同じ設定です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entspricht dem Ziehen des Trenners in der Taskleiste nach oben oder unten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revient à faire glisser le séparateur de la barre des tâches vers le haut ou vers le bas."
          }
