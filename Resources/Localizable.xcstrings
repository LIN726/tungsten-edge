    },
    "Tungsten Edge just lost its Accessibility permission, so the taskbar has been put away. Turn Tungsten Edge back on in %@.": {
      "comment": "%@ 同上",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钨极刚才失去了辅助功能权限，Dock 栏已经收起。请在%@中重新打开 Tungsten Edge 钨极的开关。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge just lost its Accessibility permission, so the taskbar has been put away. Turn Tungsten Edge back on in %@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge剛才失去了輔助使用權限，工作列已經收起。請在%@中重新打開Tungsten Edge的開關。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edgeのアクセシビリティの許可が失われたため、タスクバーを格納しました。%@でTungsten Edgeをもう一度オンにしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge hat gerade seine Bedienungshilfen-Berechtigung verloren, deshalb wurde die Taskleiste eingeklappt. Aktiviere Tungsten Edge unter %@ wieder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge vient de perdre son autorisation d’accessibilité ; la barre des tâches a donc été retirée. Réactivez Tungsten Edge dans %@."
          }
        }
      }
    },
    "Tungsten Edge needs this permission to read and manage your windows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge 需要这项权限来读取和操作窗口。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge needs this permission to read and manage your windows."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge需要這項權限來讀取與管理你的視窗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edgeはウインドウを読み取って操作するために、この許可を必要とします。"
          }
        },
        "de": {
          "stringUnit": {
