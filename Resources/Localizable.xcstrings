    "Check whether there is a typo.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查一下是不是打错了。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
